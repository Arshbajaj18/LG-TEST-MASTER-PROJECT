# Port the API (and the built frontend) is served on.
PORT=8431

# MongoDB holding categories and test masters. Add credentials if the server needs them:
# mongodb://<user>:<password>@10.102.120.46:27018/?authSource=admin
MONGODB_URI=mongodb://10.102.120.46:27018
MONGODB_DATABASE=productionDB
MONGODB_COLLECTION=testmaster

# Comma-separated origins allowed to call the API from another origin (e.g. a separately hosted frontend).
# Leave empty to allow any origin.
CORS_ORIGINS=

# Built frontend served next to the API. Defaults to ../frontend/dist; set it empty to serve the API only.
# STATIC_DIR=/opt/test-plan-masters/dist
