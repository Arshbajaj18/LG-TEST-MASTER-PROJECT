# Test Plan Masters API (../backend), which stores categories and test masters in MongoDB.
# The default "api" is relative to the page, for when the backend serves this frontend.
# Use an absolute URL when the frontend is hosted elsewhere, e.g. http://10.102.120.46:8431/api
VITE_TESTMASTER_API_ROOT=api

