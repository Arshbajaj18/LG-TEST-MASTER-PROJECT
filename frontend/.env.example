# I/O Sense API root. LG on-prem connector lives on 10.102.120.46 (same routes as cloud, different domain).
# Cloud equivalent: https://connector.iosense.io/api
VITE_IOSENSE_API_ROOT=https://10.102.120.46/api

# Bruce insight that stores categories and parsed test masters.
VITE_IOSENSE_INSIGHT_ID=INS_85cbe7954686

# Optional: value for the `organisation` header on the SSO exchange call.
# Leave empty unless the on-prem connector requires it (cloud uses https://iosense.io).
VITE_IOSENSE_ORGANISATION=

# Note: public/config.js can override these at runtime without a rebuild.
